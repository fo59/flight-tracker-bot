# Telegram Bot Token (zorunlu) — @BotFather'dan al
TELEGRAM_BOT_TOKEN=

# OpenSky API (opsiyonel ama onerilir, anonim rate-limit cok dusuk)
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# AviationStack API (yedek data source, aviationstack.com'dan ucretsiz key al)
AVIATIONSTACK_API_KEY=
# AviationStack kogulani (saat) — her ucus icin API en fazla bu siklikta cagrilir (ucretsiz tier: 100 cagri/ay)
AVIATIONSTACK_COOLDOWN_HOURS=12

# AirLabs API (yedek data source #2, airlabs.co'dan ucretsiz key, ~1000 req/ay)
AIRLABS_API_KEY=

# Bot sahibi Telegram ID (opsiyonel, /stats komutu icin)
OWNER_ID=

# Kontrol araligi (saniye, varsayilan: 300 = 5 dk)
CHECK_INTERVAL_SECONDS=300

# Inise kac dakika kala bildirim gonderilsin (varsayilan: 30)
LANDING_THRESHOLD_MINUTES=30

# Kac dakika sonra "olasi rotar" uyarisi (varsayilan: 45)
DELAY_THRESHOLD_MINUTES=45

# Veritabani ve cache dosya yollari (genelde degismez)
DB_PATH=flights.db
AIRPORTS_CACHE_PATH=airports_cache.json

# Railway'in sagladigi port (kendisi set eder, elle degistirme)
PORT=

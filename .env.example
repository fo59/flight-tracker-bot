# Telegram bot token (required), get one from @BotFather
TELEGRAM_BOT_TOKEN=

# AirLabs API key (recommended): live positions and flight status, free plan at airlabs.co
AIRLABS_API_KEY=
# Minimum seconds between AirLabs bulk requests (default: 2700 = 45 min)
AIRLABS_COOLDOWN_SECONDS=2700

# AviationStack API key (optional): schedules, used as fallback, free plan at aviationstack.com
AVIATIONSTACK_API_KEY=

# Your Telegram user ID (optional), enables the /stats command
OWNER_ID=

# How often flights are checked, in seconds (default: 300 = 5 min)
CHECK_INTERVAL_SECONDS=300

# Send the "landing soon" message this many minutes before arrival (default: 30)
LANDING_THRESHOLD_MINUTES=30

# Warn about a possible delay this many minutes after scheduled departure (default: 45)
DELAY_THRESHOLD_MINUTES=45

# Database and airport cache paths (usually no need to change)
DB_PATH=flights.db
AIRPORTS_CACHE_PATH=airports_cache.json

# Set automatically by Railway, don't set it yourself
PORT=
